# Vorlage für deploy/.env – echte Werte NIE ins Repository einchecken.
# Secrets (Zertifikate, Schlüssel, Passwörter) als Dateien im Secrets-Ordner ablegen (siehe deploy/README.md).

# --- Bereitstellung ---
# Ordner mit den Secret-Dateien auf dem Docker-Host (absoluter Pfad empfohlen).
# Ohne Angabe: Ordner "secrets" neben der docker-compose.yml.
#WERKBANK_SECRETS_DIR=/opt/werkbank/secrets
# Welches Image läuft. Ohne Angabe: die neueste veröffentlichte Version.
# Feste Version, z. B.: ghcr.io/extrempro/werkbank:0.17.1
#WERKBANK_IMAGE=ghcr.io/extrempro/werkbank:latest
# Ziel der Datensicherung. Ohne Angabe: Docker-Volume "backups". Besser ein Ordner auf dem
# Host, z. B. ein gemountetes NAS (absoluter Pfad, beschreibbar für UID 10001).
#WERKBANK_BACKUP_DIR=/mnt/sicherung/werkbank

# --- Netzwerk ---
# IP und Port auf dem Docker-Host, über die der Reverse Proxy die Werkbank erreicht.
# NICHT die öffentliche IP: interne Adresse des Hosts (z. B. im VPN) oder 127.0.0.1, wenn der
# Proxy auf demselben Host läuft. Siehe deploy/README.md, Abschnitt Netzwerk.
BIND_IP=127.0.0.1
BIND_PORT=8080

# Öffentliche Adresse der Werkbank, wie sie im Browser aufgerufen wird
# (für Entra-Redirect-URI, Herkunftsprüfung und Links in Mails).
PUBLIC_URL=https://werkbank.example.com

# Absender-IP(s) des Reverse Proxys beim Container, deren X-Forwarded-*-Header vertraut wird
# (kommagetrennt).
TRUSTED_PROXY_IPS=127.0.0.1

# --- Anmeldung (Entra ID, App-Registrierung "Werkbank") ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Zertifikat im Secrets-Ordner: entra_client_key.pem und entra_client_cert.pem
# Anleitung: docs/entra-setup.md
# Profilbild aus Entra anzeigen. Vorher an der App-Registrierung die delegierte Berechtigung
# User.Read eintragen und die Administratorzustimmung erteilen (docs/entra-setup.md, 1.5).
ENTRA_PROFILE_PHOTO=false
# Gruppen in Entra (Objekt-IDs, docs/entra-setup.md, 1.8). Admin-Gruppe: Anmeldung und
# Verwaltung. Zugangs-Gruppe: Anmeldung; die Rechte vergibt die Verwaltung der Werkbank.
# Braucht die delegierte Berechtigung User.Read. Leer: Anmeldung noch über App-Rollen.
ENTRA_ADMIN_GROUP_ID=
ENTRA_ACCESS_GROUP_ID=

# --- Datenabruf (App-Registrierung "Werkbank Collector", nur Lesen) ---
# Solange hier die Nullen stehen, findet kein Abruf statt. Anleitung: docs/entra-setup.md, Abschnitt 4.
COLLECTOR_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Abstand der Abrufe. UTCM erlaubt höchstens 20.000 gelesene Objekte pro Monat, deshalb täglich.
COLLECTOR_INTERVAL_HOURS=24
# Abrufe ohne Änderungen nach so vielen Tagen löschen (0 = nie); die letzten 10 bleiben immer
COLLECTOR_SNAPSHOT_KEEP_DAYS=90
# Tickets: so viele Minuten gilt die über Graph geprüfte Gruppenmitgliedschaft einer Person
TICKETS_MEMBERSHIP_CACHE_MINUTES=5
# Tickets: App-Registrierung „Werkbank Tickets“ für die Postfächer (docs/entra-setup.md, 4b).
# Leer = Postfächer nicht angebunden, Tickets nur von Hand. Zertifikat wie die Collector-App
# (TICKETS_MAIL_CLIENT_KEY_FILE / TICKETS_MAIL_CLIENT_CERT_FILE für ein eigenes).
TICKETS_MAIL_CLIENT_ID=
# Eigene Maildomänen, kommagetrennt; Absender anderer Domänen gelten als extern
TICKETS_INTERNAL_DOMAINS=example.com
# Zeitzone für Arbeitszeiten, Fristen und Erinnerungen der Tickets
TICKETS_TIMEZONE=Europe/Berlin
# Abstand, in dem das Nachrichtencenter gelesen wird (Modul Evergreen), in Stunden
MESSAGE_CENTER_INTERVAL_HOURS=6

# Empfehlungen aus Microsoft Secure Score lesen (Seite „Empfehlungen“).
# Vorher der Collector-App die Berechtigung SecurityEvents.Read.All geben (docs/entra-setup.md).
SECURE_SCORE_ENABLED=false
SECURE_SCORE_INTERVAL_HOURS=24

# Lizenzen und Benutzerzahlen des Tenants lesen (Seiten „Lizenzen“ und „Benutzer“).
# Vorher der Collector-App die Berechtigungen Organization.Read.All und User.Read.All geben
# (docs/entra-setup.md, Abschnitt 4.1). Gespeichert werden nur Summen, keine Namen.
TENANT_MONITOR_ENABLED=false
TENANT_MONITOR_INTERVAL_HOURS=24
# Zertifikate und Secrets der Anwendungen im Tenant lesen (Seite „Zertifikate und Secrets“).
# Vorher der Collector-App die Berechtigung Application.Read.All geben (docs/entra-setup.md, 4.1).
# Gelesen werden nur Bezeichnung und Ablaufdatum, nie der geheime Wert.
TENANT_CREDENTIALS_ENABLED=false
# Dienststatus von Exchange Online, Teams, SharePoint Online und Entra lesen (Seite „Dienststatus“).
# Vorher der Collector-App die Berechtigung ServiceHealth.Read.All geben (docs/entra-setup.md, 4.1).
TENANT_HEALTH_ENABLED=false
TENANT_HEALTH_INTERVAL_MINUTES=15
# Nutzung der Dienste (aktive und inaktive Benutzer je Dienst, Seite „Nutzung“), alle 12 Stunden.
# Vorher der Collector-App die Berechtigung Reports.Read.All geben (docs/entra-setup.md, 4.1).
# Gelesen werden nur Summen je Dienst, keine Berichte mit Personen.
TENANT_USAGE_ENABLED=false
# Gerätezuordnung: Status neuer Geräte im Hintergrund prüfen (alle 5 Minuten, nur lesend).
# Vorher der Collector-App DeviceManagementServiceConfig.Read.All und
# DeviceManagementManagedDevices.Read.All geben (docs/entra-setup.md, 4a.3).
# Das Zuordnen selbst läuft mit dem Admin-Konto der Person (delegiert), nie mit dieser App.
DEVICES_MONITOR_ENABLED=false
# UTCM-Ressourcentypen, kommagetrennt. Exchange Online lässt sich ergänzen, z. B.
# ,microsoft.exchange.transportrule,microsoft.exchange.antiphishpolicy
# Vorher die Rechte vergeben; vollständige Liste und Anleitung: docs/entra-setup.md, Abschnitt 4.3.
# Teams (organisationsweite Richtlinien): docs/entra-setup.md, Abschnitt 4.4; Intune: Abschnitt 4.6.
COLLECTOR_RESOURCES=microsoft.entra.conditionalaccesspolicy,microsoft.entra.namedlocationpolicy,microsoft.entra.authorizationpolicy
# Höchstens so viele Typen je UTCM-Auftrag (1–50, Vorgabe 10). Workloads mit mehr Typen (z. B. Intune)
# werden in gleich große Teile geteilt, z. B. 29 → 10/10/9; jeder Teil ist ein eigener Auftrag, alles
# landet in einem Abruf. Scheitert ein Teil beim Download weiter mit 502, den Wert kleiner setzen.
# UTCM erlaubt höchstens 12 Aufträge gleichzeitig; Teile ohne freien Platz kommen im nächsten Lauf dran.
COLLECTOR_MAX_TYPES_PER_JOB=10
# SharePoint- und OneDrive-Mandanteneinstellungen über Microsoft Graph mitlesen (UTCM kann das nicht).
# Vorher der Collector-App SharePointTenantSettings.Read.All geben (docs/entra-setup.md, 4.5).
COLLECTOR_SHAREPOINT_ENABLED=false
# Zertifikat im Secrets-Ordner: collector_client_key.pem und collector_client_cert.pem

# --- Datenbank ---
# Host und Passwort-Datei setzt docker-compose.yml selbst.
POSTGRES_DB=werkbank
POSTGRES_USER=werkbank
# Passwort im Secrets-Ordner: postgres_password

# --- Sitzung ---
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
STEP_UP_MINUTES=15

# --- Schutz vor Missbrauch ---
# Höchstzahl Anfragen pro Minute und Absender-IP (0 = aus). Alle Personen an einem Standort
# teilen sich meist eine IP, deshalb nicht zu knapp wählen.
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_EXPORT_PER_MINUTE=10

# --- Benachrichtigungen ---
MAIL_SENDER=werkbank@example.com
# VAPID-Schlüssel für Web Push als Docker-Secrets: secrets/vapid_private_key, secrets/vapid_public_key

# --- Sonstiges ---
TZ=Europe/Berlin
LOG_LEVEL=info
# production | development | test
ENVIRONMENT=production
# Test-Login ohne Entra. Startet nur bei ENVIRONMENT=test oder development, NIE in Produktion.
ENABLE_TEST_LOGIN=false
