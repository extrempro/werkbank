# Vorlage für deploy/.env – echte Werte NIE ins Repository einchecken.
# Secrets (Zertifikate, Schlüssel, Passwörter) als Docker-Secrets unter deploy/secrets/ ablegen.

# --- Netzwerk ---
# IP und Port, an die der Web-Container auf dem Host gebunden wird.
# Der NetBird Reverse Proxy leitet auf diese Adresse weiter.
BIND_IP=127.0.0.1
BIND_PORT=8080

# Öffentliche Adresse der Werkbank (für Entra-Redirect-URI und Links in Mails).
PUBLIC_URL=https://werkbank.example.com

# IP(s) des Reverse Proxys, deren X-Forwarded-*-Header vertraut wird (kommagetrennt).
TRUSTED_PROXY_IPS=127.0.0.1

# --- Anmeldung (Entra ID, App-Registrierung "Werkbank") ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client-Secret bzw. Zertifikat als Docker-Secret: secrets/entra_client_credential

# --- Datenabruf (App-Registrierung "Werkbank Collector", nur Lesen) ---
COLLECTOR_CLIENT_ID=00000000-0000-0000-0000-000000000000
COLLECTOR_INTERVAL_HOURS=6
# Zertifikat als Docker-Secret: secrets/collector_certificate

# --- Datenbank ---
POSTGRES_DB=werkbank
POSTGRES_USER=werkbank
# Passwort als Docker-Secret: secrets/postgres_password

# --- Sitzung ---
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
STEP_UP_MINUTES=15

# --- Benachrichtigungen ---
MAIL_SENDER=werkbank@example.com
# VAPID-Schlüssel für Web Push als Docker-Secrets: secrets/vapid_private_key, secrets/vapid_public_key

# --- Sonstiges ---
TZ=Europe/Berlin
LOG_LEVEL=info
